// Better Auth 1.6.27 core schema is generated into
// prisma/generated/better-auth.prisma with `pnpm better-auth:migrate`.
// This merged Prisma model adds Moodday domain relations and legacy-compatible
// optional fields; core auth tables must stay aligned with the generated file.

model User {
  id                               String   @id
  name                             String
  email                            String
  emailVerified                    Boolean
  image                            String?
  createdAt                        DateTime
  updatedAt                        DateTime
  resendContactId                  String?
  twoFactorEnabled                 Boolean? @default(false)
  age18Accepted                    Boolean? @default(false)
  termsVersionAccepted             String?
  privacyVersionAccepted           String?
  healthDataConsentVersionAccepted String?
  signupLocale                     String?  @default("fr")
  launchCountry                    String?  @default("FR")

  // Outgoing
  sessions                 Session[]
  accounts                 Account[]
  feedbacks                Feedback[]
  subscription             Subscription?
  moodEntries              MoodEntry[]
  medications              Medication[]
  therapySessions          TherapySession[]
  exercises                Exercise[]
  preferences              UserPreferences?
  consents                 UserConsent[]
  moodTagDefinitions       MoodTagDefinition[]
  consultationPreparations ConsultationPreparation[]
  safetyPlan               SafetyPlan?

  // Mood Day V2 shared web/mobile domain
  checkIns             CheckIn[]
  observations         Observation[]
  dailyAggregates      DailyAggregate[]
  sourceConnections    SourceConnection[]
  routines             Routine[]
  clinicians           Clinician[]
  appointments         Appointment[]
  devices              Device[]
  syncOperations       SyncOperation[]
  subscriptionSources  SubscriptionSource[]
  entitlementSnapshots EntitlementSnapshot[]
  billingEvents        BillingEvent[]

  // Mood Day V2 patient-controlled Circle
  circleRelationshipsAsPatient   CircleRelationship[]    @relation("V2CirclePatient")
  circleRelationshipsAsCaregiver CircleRelationship[]    @relation("V2CircleCaregiver")
  supportRequestsCreated         SupportRequest[]        @relation("V2SupportRequestPatient")
  supportRequestsReceived        SupportRequest[]        @relation("V2SupportRequestCaregiver")
  circleAccessesMade             AccessLog[]             @relation("V2AccessLogActor")
  circleAccessesReceived         AccessLog[]             @relation("V2AccessLogPatient")
  caregiverContributionsMade     CaregiverContribution[] @relation("V2ContributionAuthor")
  caregiverContributionsReceived CaregiverContribution[] @relation("V2ContributionPatient")

  // Caregiver relations
  observationsMade     CaregiverObservation[] @relation("ObserverRelation")
  observationsReceived CaregiverObservation[] @relation("SubjectRelation")
  eventsReported       CaregiverEvent[]       @relation("ReporterRelation")
  eventsAbout          CaregiverEvent[]       @relation("EventSubjectRelation")

  // Caregiver relationship system
  caregivingFor        CaregiverRelationship[] @relation("CaregiverRelations") // As caregiver
  caregivers           CaregiverRelationship[] @relation("PatientRelations") // As patient
  caregiverRevocations CaregiverRelationship[] @relation("CaregiverRevokedBy")

  // Content-free caregiver access audit trail
  caregiverAccessesMade     CaregiverAccessLog[] @relation("CaregiverAccessActor")
  caregiverAccessesReceived CaregiverAccessLog[] @relation("CaregiverAccessPatient")

  // Email tracking
  emailLogs EmailLog[]

  // Technical delivery log. Payloads and medical content are never stored.
  notificationDeliveries NotificationDelivery[]
  pushSubscriptions      PushSubscription[]

  // Content-free operational records.
  aiUsageRecords             AIUsage[]
  twofactors                 TwoFactor[]
  passkeys                   Passkey[]
  medicationIntakeRevisions  MedicationIntakeRevision[]
  medicationMutationReceipts MedicationMutationReceipt[]

  // Stripe integration
  stripeCustomerId String?

  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// Content-free counters used by Better Auth and sensitive application actions.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("rateLimit")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String    @unique
  user                 User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?
  priceId              String?
  billingInterval      String?
  trialUsedAt          DateTime?
  graceEndsAt          DateTime?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeSubscriptionId])
  @@index([status, periodEnd])
  @@map("subscription")
}
