// Moodday couple domain: she tells how she feels during her cycle, her
// partner understands and answers with a gesture. Product invariants:
// - the cycle owner is the only person who ever writes her cycle data;
// - a partner only reads a server-side projection filtered by the link level;
// - nothing is inferred from the calendar alone (no check-in, no alert).

/// One row per account: which side of the duo the account is on, and the
/// onboarding answers used to personalise the app. Never shared as such.
model Profile {
  userId              String      @id
  role                MooddayRole
  displayName         String?
  // Cycle owner onboarding.
  typicalCycleLength  Int? // days, 21..45
  typicalPeriodLength Int? // days, 2..10
  hardestThings       String[]    @default([])
  usualNeeds          String[]    @default([])
  // Supporter onboarding: what he or she wants to understand better.
  supporterFocus      String[]    @default([])
  onboardedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

/// A period as declared by the cycle owner. An open period has no end date.
model Period {
  id        String    @id @default(cuid())
  userId    String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startDate])
  @@index([userId, startDate])
  @@map("period")
}

/// "Mon point": one check-in per civil day, editable during that day.
model DailyCheckIn {
  id          String       @id @default(cuid())
  userId      String
  operationId String
  localDate   DateTime     @db.Date
  timezone    String
  state       CheckInState
  symptoms    String[]     @default([])
  needs       String[]     @default([])
  // Private by construction: never part of any partner projection.
  privateNote String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gestures Gesture[]

  @@unique([userId, localDate])
  @@unique([userId, operationId])
  @@index([userId, localDate])
  @@map("daily_check_in")
}

/// Needs the cycle owner wrote herself, on top of the built-in catalogue.
model CustomNeed {
  id        String   @id @default(cuid())
  userId    String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("custom_need")
}

/// The couple link. At most one pending or active link per account is
/// enforced by partial unique indexes in the initial migration.
model CoupleLink {
  id               String           @id @default(cuid())
  ownerId          String?
  supporterId      String?
  invitedByRole    MooddayRole
  status           CoupleLinkStatus @default(invited)
  inviteCodeDigest String?          @unique
  inviteExpiresAt  DateTime?
  // What the supporter can see. Chosen by the cycle owner, with a preview.
  level            SharingLevel     @default(cycle_state_needs)
  shareSymptoms    Boolean          @default(false)
  // Lock-screen notifications stay generic unless she opts in.
  detailedPreviews Boolean          @default(false)
  sharingVersion   Int              @default(1)
  pausedUntil      DateTime?
  acceptedAt       DateTime?
  endedAt          DateTime?
  endedById        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner     User?       @relation("CoupleLinkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  supporter User?       @relation("CoupleLinkSupporter", fields: [supporterId], references: [id], onDelete: Cascade)
  endedBy   User?       @relation("CoupleLinkEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  gestures  Gesture[]
  accesses  AccessLog[]

  @@index([ownerId, status])
  @@index([supporterId, status])
  @@map("couple_link")
}

/// A partner's answer to a check-in or a need: one tap or a short word.
model Gesture {
  id          String        @id @default(cuid())
  linkId      String
  senderId    String
  recipientId String
  checkInId   String?
  operationId String
  kind        String // catalogue key, or "custom"
  message     String?
  status      GestureStatus @default(sent)
  seenAt      DateTime?
  thankedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  link      CoupleLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  sender    User          @relation("GestureSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User          @relation("GestureRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  checkIn   DailyCheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@unique([senderId, operationId])
  @@index([linkId, createdAt])
  @@index([recipientId, status])
  @@map("gesture")
}

/// Ally programme progress. Lesson content lives in versioned MDX files.
model AllyProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonSlug  String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([userId, completedAt])
  @@map("ally_progress")
}

/// One row per onboarding email actually sent, so a step is never repeated.
model LifecycleEmail {
  id     String   @id @default(cuid())
  userId String
  step   String
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, step])
  @@map("lifecycle_email")
}

/// Content-free trail of what a partner looked at or changed.
model AccessLog {
  id           String       @id @default(cuid())
  ownerId      String
  actorId      String
  linkId       String?
  action       AccessAction
  resourceKind String
  createdAt    DateTime     @default(now())

  owner User        @relation("AccessLogOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  actor User        @relation("AccessLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  link  CoupleLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([linkId, createdAt])
  @@map("access_log")
}

/// Registered app installs, used for Expo push delivery.
model Device {
  id                 String         @id @default(cuid())
  userId             String
  publicId           String
  platform           DevicePlatform
  displayName        String?
  pushToken          String?
  pushTokenUpdatedAt DateTime?
  lastSeenAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, publicId])
  @@index([userId, revokedAt])
  @@map("device")
}

model SubscriptionSource {
  id                     String                   @id @default(cuid())
  userId                 String
  provider               SubscriptionProvider
  externalCustomerId     String?
  externalSubscriptionId String?
  productId              String?
  status                 SubscriptionSourceStatus
  currentPeriodEndsAt    DateTime?
  lastVerifiedAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSubscriptionId])
  @@index([userId, status])
  @@map("subscription_source")
}

model EntitlementSnapshot {
  id              String                 @id @default(cuid())
  userId          String
  entitlement     String
  active          Boolean
  sourceProviders SubscriptionProvider[] @default([])
  validUntil      DateTime?
  calculatedAt    DateTime               @default(now())
  createdAt       DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entitlement, calculatedAt])
  @@map("entitlement_snapshot")
}

model BillingEvent {
  id              String               @id @default(cuid())
  userId          String?
  provider        SubscriptionProvider
  externalEventId String
  eventType       String
  status          BillingEventStatus   @default(received)
  occurredAt      DateTime
  processedAt     DateTime?
  errorCode       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
  @@map("billing_event")
}

enum MooddayRole {
  cycle_owner
  supporter
}

enum CheckInState {
  ok
  fragile
  hard
  very_hard
}

enum CoupleLinkStatus {
  invited
  active
  ended
}

enum SharingLevel {
  cycle_only
  cycle_state
  cycle_state_needs
}

enum GestureStatus {
  sent
  seen
  thanked
}

enum AccessAction {
  viewed
  gesture_sent
  sharing_changed
  paused
  resumed
  ended
}

enum DevicePlatform {
  web
  ios
  android
}

enum SubscriptionProvider {
  stripe
  app_store
  play_store
}

enum SubscriptionSourceStatus {
  active
  trialing
  grace
  paused
  expired
  refunded
}

enum BillingEventStatus {
  received
  processed
  ignored
  failed
}
