{
  "expo": {
    "name": "Moodday",
    "slug": "mood-day",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "scheme": "moodday",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.yodev.moodday"
    },
    "android": {
      "package": "fr.yodev.moodday",
      "adaptiveIcon": {
        "backgroundColor": "#FBF4EA"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF4EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1E1322",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "973b3a37-c1d3-4dac-a327-20d4b9bbd18e"
      }
    },
    "owner": "yoanndrx",
    "description": "Moodday aide les couples à traverser le SPM : elle fait son point du jour, son ou sa partenaire reçoit des idées de gestes."
  }
}
