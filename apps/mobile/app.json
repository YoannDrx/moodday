{
  "expo": {
    "name": "Mood Day",
    "slug": "mood-day",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "scheme": "moodday",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.yodev.moodday"
    },
    "android": {
      "package": "fr.yodev.moodday",
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "973b3a37-c1d3-4dac-a327-20d4b9bbd18e"
      }
    },
    "owner": "yoanndrx"
  }
}
