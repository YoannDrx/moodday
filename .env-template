# ═══════════════════════════════════════════════════════════════════════════════
# light-ts - Template de variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════════
# Copie ce fichier vers .env.local et remplis les valeurs
# Ou utilise: pnpm setup pour une configuration guidée

# ═══════════════════════════════════════════════════════════════════════════════
# CORE - Toujours requis
# ═══════════════════════════════════════════════════════════════════════════════

# Base de données PostgreSQL (NeonDB recommandé)
# https://neon.tech - Créer un projet puis copier la connection string
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Tests E2E uniquement : branche Neon isolée ou base locale jetable.
# Playwright refuse par défaut de réutiliser DATABASE_URL.
PLAYWRIGHT_DATABASE_URL=""
PLAYWRIGHT_DATABASE_URL_UNPOOLED=""

# Better Auth - Authentification
# BETTER_AUTH_SECRET: généré automatiquement par pnpm setup
# Ou manuellement: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════════
# AUTH PROVIDERS - Optionnel selon les besoins
# ═══════════════════════════════════════════════════════════════════════════════

# GitHub OAuth (optionnel)
# https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optionnel)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════════
# EMAILS - Resend (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════
# https://resend.com/api-keys

RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
EMAIL_FROM="Moodday <moodday@yodev.fr>"
NEXT_PUBLIC_EMAIL_CONTACT="hello@moodday.app"

# ═══════════════════════════════════════════════════════════════════════════════
# BILLING - Stripe (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════
# https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Webhook secret - Obtenu via: pnpm stripe-webhooks
STRIPE_WEBHOOK_SECRET=""

# Plans IDs - Créer les produits/prix dans Stripe Dashboard
STRIPE_PRO_PLAN_ID=""
STRIPE_PRO_YEARLY_PLAN_ID=""
STRIPE_ULTRA_PLAN_ID=""
STRIPE_ULTRA_YEARLY_PLAN_ID=""

# ═══════════════════════════════════════════════════════════════════════════════
# CACHE - Redis via Upstash (obligatoire)
# ═══════════════════════════════════════════════════════════════════════════════
# Créé automatiquement par: pnpm setup
# Ou manuellement: upstash redis create --name=myapp --region=eu-west-1
# Console: https://console.upstash.com
# Format: redis://default:PASSWORD@ENDPOINT:PORT

REDIS_URL=""

# ═══════════════════════════════════════════════════════════════════════════════
# ANALYTICS - PostHog (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════
# https://posthog.com

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ═══════════════════════════════════════════════════════════════════════════════
# UPLOADS - UploadThing (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════
# https://uploadthing.com

UPLOADTHING_TOKEN=""
