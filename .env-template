# ═══════════════════════════════════════════════════════════════════════════════
# Moodday - Template de variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════════
# Copie ce fichier vers .env.local et remplis les valeurs
# Ou utilise: pnpm setup pour une configuration guidée
# Ne jamais déployer un fichier .env avec la CLI Vercel. Provisionner Preview
# et Production séparément, puis exécuter `pnpm verify:vercel-predeploy`.

# ═══════════════════════════════════════════════════════════════════════════════
# CORE - Toujours requis
# ═══════════════════════════════════════════════════════════════════════════════

# Base de données PostgreSQL (NeonDB recommandé)
# https://neon.tech - Créer un projet puis copier la connection string
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Tests E2E uniquement : branche Neon isolée ou base locale jetable.
# Playwright refuse par défaut de réutiliser DATABASE_URL.
PLAYWRIGHT_DATABASE_URL=""
PLAYWRIGHT_DATABASE_URL_UNPOOLED=""

# Better Auth - Authentification
# BETTER_AUTH_SECRET: généré automatiquement par pnpm setup
# Ou manuellement: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════════
# AUTH PROVIDERS - Optionnel selon les besoins
# ═══════════════════════════════════════════════════════════════════════════════

# GitHub OAuth (optionnel)
# https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optionnel)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════════
# EMAILS - Resend (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════
# https://resend.com/api-keys

RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Moodday <moodday@yodev.fr>"
NEXT_PUBLIC_EMAIL_CONTACT="hello@moodday.app"

# ═══════════════════════════════════════════════════════════════════════════════
# BILLING - Stripe (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════
# Compte exclusivement Moodday. Commencer par les clés test.
# https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_ACCOUNT_ID=""

# Webhook secret - Obtenu via: pnpm stripe-webhooks
STRIPE_WEBHOOK_SECRET=""

# Catalogue v1, vérifié côté serveur avant chaque Checkout
STRIPE_PLUS_MONTHLY_PRICE_ID=""
STRIPE_PLUS_YEARLY_PRICE_ID=""
STRIPE_PORTAL_CONFIGURATION_ID=""
BILLING_ENABLED="false"
STRIPE_TAX_ENABLED="false"
# À renseigner uniquement après confirmation comptable depuis la liste Stripe.
STRIPE_PRODUCT_TAX_CODE=""
CAREGIVER_SHARING_ENABLED="false"
ACCOUNT_IMPORT_ENABLED="false"
ADMIN_ENABLED="false"
MAINTENANCE_MODE="false"

# ═══════════════════════════════════════════════════════════════════════════════
# IA - OpenAI (bêta, désactivée par défaut)
# ═══════════════════════════════════════════════════════════════════════════════

OPENAI_API_KEY=""
AI_INSIGHTS_MODEL="gpt-5.6"
AI_INSIGHTS_ENABLED="false"
# `internal` limite l'accès aux identifiants ci-dessous, même si le flag est actif.
AI_ROLLOUT_MODE="internal"
AI_INTERNAL_USER_IDS=""
AI_CONSENT_VERSION="ai-insights-2026-08"
# Générer une valeur dédiée de 32 caractères minimum. Ne pas réutiliser un secret.
AI_SAFETY_HMAC_SECRET=""
AI_MONTHLY_REQUEST_BUDGET="1000"
AI_MAX_CONCURRENCY="5"
AI_TIMEOUT_MS="15000"

# ═══════════════════════════════════════════════════════════════════════════════
# PUSH ET CRONS
# ═══════════════════════════════════════════════════════════════════════════════

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:hello@moodday.app"
CRON_SECRET=""
OPERATIONAL_ALERT_EMAIL=""
PUSH_NOTIFICATIONS_ENABLED="false"

# Export réglementaire en ligne de commande uniquement.
# Générer une clé dédiée avec `openssl rand -base64 32`.
DSAR_EXPORT_ENCRYPTION_KEY=""
# URL publique canonique utilisée dans le fichier de remise DSAR (HTTPS).
DSAR_DOWNLOAD_BASE_URL=""
# Jeton Blob distinct entre Preview et Production, requis pour la remise privée.
BLOB_READ_WRITE_TOKEN=""

# ═══════════════════════════════════════════════════════════════════════════════
# RELEASE ET CONSENTEMENTS
# ═══════════════════════════════════════════════════════════════════════════════

LEGAL_TERMS_VERSION="terms-2026-08"
LEGAL_PRIVACY_VERSION="privacy-2026-08"
HEALTH_DATA_CONSENT_VERSION="health-data-2026-08"
LAUNCH_COUNTRY="FR"
MINIMUM_AGE="18"
