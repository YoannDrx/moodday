{
  "name": "moodday",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "env:audit": "tsx scripts/environment-audit.ts",
    "build": "next build",
    "clean": "next lint --fix && tsc --noEmit && prettier --write .",
    "dev": "next dev --turbopack",
    "dev:mobile": "pnpm --filter @moodday/mobile start",
    "mobile:ios": "pnpm --filter @moodday/mobile ios",
    "mobile:android": "pnpm --filter @moodday/mobile android",
    "mobile:build:preview": "pnpm --filter @moodday/mobile eas:build:preview",
    "mobile:build:production": "pnpm --filter @moodday/mobile eas:build:production",
    "mobile:build:production:android": "pnpm --filter @moodday/mobile eas:build:production:android",
    "mobile:e2e:ios": "pnpm --filter @moodday/mobile eas:workflow:e2e:ios",
    "mobile:e2e:android": "pnpm --filter @moodday/mobile eas:workflow:e2e:android",
    "mobile:maestro": "pnpm --filter @moodday/mobile maestro:test",
    "typecheck:mobile": "pnpm --filter @moodday/mobile typecheck && tsc --noEmit -p tsconfig.native-tests.json",
    "email": "email dev",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "knip": "knip --config knip.json",
    "lint": "eslint . --fix",
    "start": "next start",
    "stripe-webhooks": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "ts": "tsc --noEmit",
    "vercel-build": "prisma generate && if [ \"$VERCEL_ENV\" = production ]; then pnpm db:migration-guard; fi && next build",
    "test": "vitest",
    "test:e2e": "HEADLESS=0 playwright test --ui",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:release": "COVERAGE_RELEASE_GATE=true vitest run --coverage",
    "test:e2e:ci": "HEADLESS=TRUE playwright test",
    "lint:ci": "eslint .",
    "verify": "pnpm lint:ci && pnpm ts && pnpm test:ci && pnpm audit:all && pnpm prisma validate && pnpm verify:vercel-source-boundary && pnpm build && pnpm knip",
    "audit:all": "pnpm vitest run __tests__/supply-chain-patches.test.ts && pnpm audit --audit-level=high --ignore CVE-2026-56876 --ignore CVE-2026-85393",
    "sbom": "tsx scripts/generate-sbom.ts",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --excludePackages 'next-mdx-remote-client@2.1.5' --onlyAllow '0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;CC-BY-3.0;CC-BY-4.0;CC0-1.0;ISC;MIT;MPL-2.0;Python-2.0;Unlicense'",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:prepare": "tsx scripts/prepare-lighthouse-user.ts",
    "lighthouse:release": "pnpm lighthouse:prepare && lhci autorun --config=./lighthouserc.release.cjs",
    "better-auth:migrate": "NODE_ENV=development pnpm exec auth generate --config scripts/better-auth-schema.config.ts --output prisma/generated/better-auth.prisma --yes",
    "prisma:seed": "NODE_ENV=development prisma db seed",
    "prisma:migrate": "pnpm prisma migrate dev",
    "prisma:generate": "pnpm prisma generate",
    "db:migration-guard": "tsx scripts/check-production-migrations.ts",
    "verify:operational-jobs": "NODE_ENV=test tsx scripts/verify-operational-jobs.ts",
    "verify:auth-rate-limit": "NODE_OPTIONS=--conditions=react-server NODE_ENV=test tsx scripts/verify-auth-rate-limit.ts",
    "verify:migration-upgrade": "NODE_ENV=test tsx scripts/verify-migration-upgrade.ts",
    "verify:backup-restore": "NODE_ENV=test tsx scripts/verify-backup-restore.ts",
    "verify:vercel-environment": "tsx scripts/verify-vercel-environment.ts",
    "verify:vercel-source-boundary": "tsx scripts/verify-vercel-source-boundary.ts",
    "verify:credential-rotations": "tsx scripts/verify-credential-rotation-evidence.ts",
    "verify:release-approvals": "tsx scripts/verify-release-approval-evidence.ts",
    "verify:vercel-predeploy": "pnpm verify:vercel-source-boundary && pnpm verify:credential-rotations && pnpm verify:release-approvals && pnpm verify:vercel-environment -- --compare-values",
    "vercel:configure-safe-defaults": "tsx scripts/configure-vercel-release-defaults.ts",
    "maintenance:revoke-unverified-sessions": "tsx scripts/revoke-unverified-sessions.ts",
    "notifications:retry-dead": "tsx scripts/retry-dead-notification.ts",
    "dsar:generate": "NODE_ENV=production tsx scripts/generate-regulatory-export.ts",
    "stripe:configure-catalog": "tsx scripts/configure-stripe-catalog.ts",
    "stripe:validate-catalog": "tsx scripts/validate-stripe-catalog.ts",
    "stripe:verify-test-clocks": "tsx --env-file=.env.local scripts/verify-stripe-test-clocks.ts",
    "release:schema-inventory": "tsx scripts/release-schema-inventory.ts",
    "benchmark:account-export": "tsx scripts/benchmark-account-export.ts"
  },
  "prisma": {
    "seed": "pnpm tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@better-auth/passkey": "1.7.14",
