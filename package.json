  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.11": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "bn.js@4.12.2": "4.12.3",
      "defu@6.1.4": "6.1.7",
