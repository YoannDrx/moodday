      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.5",
      "socket.io-parser@4.2.4": "4.2.7",
      "tmp@0.0.33": "0.2.7",
      "tmp@0.1.0": "0.2.7",
      "yaml@2.8.1": "2.8.3",
      "ws@8.18.3": "8.21.3"
    },
    "patchedDependencies": {
      "extract-zip@2.0.1": "patches/extract-zip@2.0.1.patch"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-56876"
      ]
    }
  }
