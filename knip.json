{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved"
  ],
  "ignore": [
    "src/components/ui/*",
    "*.config.js",
    "playwright.config.ts",
    "src/lib/server-url.ts",
    "src/site-config.ts",
    "e2e/**",
    ".claude/**",
    "prisma/**",
    "artifacts/**"
  ],
  "ignoreDependencies": ["tailwindcss", "tailwindcss-animate"],
  "ignoreBinaries": ["stripe"],
  "paths": {
    "@/*": ["./src/*"],
    "@app/*": ["./app/*"],
    "@email/*": ["./emails/*"]
  },
  "entry": [
    "**/unauthorized.tsx",
    "**/sitemap.tsx",
    "proxy.ts",
    "public/sw.js",
    "scripts/better-auth-schema.config.ts",
    "lighthouserc.cjs",
    "lighthouserc.release.cjs",
    "scripts/lighthouse-auth.cjs",
    "src/components/**"
  ]
}
